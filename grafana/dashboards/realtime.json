      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE l.status = 'IN_AIR') AS \"进行中\",\n       count(*) FILTER (WHERE l.status = 'LANDED')  AS \"近一小时落地\",\n       count(*) FILTER (WHERE l.status = 'LOST')    AS \"近一小时丢失\"\nFROM dwd_flight_leg l\nCROSS JOIN rt_sync_state s\nWHERE l.status = 'IN_AIR' OR l.end_time >= s.data_clock - INTERVAL '1 hour'"
        }
      ],
      "options": {
        "reduceOptions": {
