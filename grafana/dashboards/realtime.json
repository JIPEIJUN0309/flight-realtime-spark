    {
      "id": 9,
      "type": "table",
      "title": "近一小时起降（$airport）",
      "description": "数据时钟之前一小时内，在 $airport 判出的起飞和落地事件（规则见需求文档「起降判定」）。",
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 15
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT e.event_time      AS \"时间\",\n       CASE e.event_type WHEN 'LANDING' THEN '落地' ELSE '起飞' END AS \"类型\",\n       e.callsign        AS \"呼号\",\n       e.icao24,\n       e.airport_dist_km AS \"离机场 km\",\n       e.gap_s           AS \"翻转间隔 s\"\nFROM dwd_airport_event e\nCROSS JOIN rt_sync_state s\nWHERE e.airport_iata = ${airport:sqlstring}\n  AND e.event_time >= s.data_clock - INTERVAL '1 hour'\nORDER BY e.event_time DESC\nLIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      }
    },
