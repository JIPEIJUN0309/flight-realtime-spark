          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT l.callsign AS \"呼号\",\n       l.icao24,\n       CASE l.departure_kind WHEN 'TAKEOFF' THEN l.departure_iata\n                             WHEN 'UNDETECTED' THEN '未知' ELSE '区域外' END AS \"起飞\",\n       l.start_time AS \"开始\",\n       CASE l.status WHEN 'IN_AIR' THEN '进行中' WHEN 'LANDED' THEN '已落地' ELSE '丢失' END AS \"状态\",\n       l.arrival_iata AS \"落地\",\n       l.end_time AS \"结束\",\n       CASE l.lost_reason WHEN 'SUSPECTED_LANDING' THEN '疑似落地未识别'\n                          WHEN 'EXITED' THEN '飞出范围'\n                          WHEN 'SIGNAL_LOST' THEN '信号丢失' END AS \"丢失原因\",\n       l.last_seen AS \"最后出现\",\n       l.last_airport_iata AS \"最近机场\",\n       l.last_airport_dist_km AS \"距离 km\",\n       l.last_altitude_m AS \"高度 m\",\n       l.max_altitude_m AS \"最大高度 m\"\nFROM dwd_flight_leg l\nCROSS JOIN rt_sync_state s\nWHERE (l.status = 'IN_AIR' OR l.end_time >= s.data_clock - INTERVAL '1 hour')\n  AND CASE WHEN ${callsign:sqlstring} = ''\n           THEN ${airport:sqlstring} IN (l.departure_iata, l.arrival_iata, l.last_airport_iata)\n           ELSE l.callsign ILIKE '%' || ${callsign:sqlstring} || '%' OR l.icao24 = lower(${callsign:sqlstring})\n      END\nORDER BY l.last_seen DESC\nLIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": []
      }
    },
