    {
      "id": 2,
      "type": "stat",
      "title": "当前进近架数",
      "description": "最近 30 秒有更新（相对最新快照时间）、没离开的飞机里，按最近机场归属到 $airport、距离 ≤ 30 km、气压高度 ≤ 3,000 m、垂直速率 ≤ −1 m/s 的架数。口径见需求文档「指标口径」，判定写在视图 rt_current_position 里。",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "flightdb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "flightdb"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE is_approach) AS \"进近\"\nFROM rt_current_position\nWHERE near_airport_iata = ${airport:sqlstring}"
