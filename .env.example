# ============================================================
# 复制这个文件为 .env，填入你自己的值。
#   cp .env.example .env
# .env 已被 .gitignore 忽略，不会上传到 GitHub。
# ============================================================

# ---- OpenSky API 凭据（必填）----
# 到 https://opensky-network.org/my-opensky/account 创建 API client 后获得
OPENSKY_CLIENT_ID=your_client_id_here
OPENSKY_CLIENT_SECRET=your_client_secret_here

# ---- Kafka（本地默认即可，一般不用改）----
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=flights

# ---- 采集间隔（秒）----
# 开发调试可设 60 省额度；正常跑用 30
POLL_INTERVAL=30

# ---- 采集区域 bounding box（默认欧洲，面积≤25平方度=每次1credit）----
# 想看别的区域改这四个值：
#   欧洲(默认): 45/5/50/10
#   美国东北:   40/-80/44/-73
#   中国华东:   29/118/33/122
BBOX_LAMIN=45.0
BBOX_LOMIN=5.0
BBOX_LAMAX=50.0
BBOX_LOMAX=10.0
